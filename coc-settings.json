{
    "codeLens.position": "eol",
    "codeLens.separator": "\t",
    "inlayHint.refreshOnInsertMode": true,
    "markdown-preview-enhanced.previewTheme": "github-dark.css",
    "yank.enableCompletion": false,
    "suggest.completionItemKindLabels": {
        "constructor": "󰘦",
        "keyword": "",
        "variable": "",
        "value": "",
        "operator": "",
        "function": "󰊕",
        "reference": "",
        "constant": "",
        "method": "",
        "struct": "",
        "class": "",
        "interface": "",
        "text": "",
        "enum": "",
        "enumMember": "",
        "module": "󰕳",
        "color": "",
        "property": "",
        "field": "",
        "unit": "",
        "event": "",
        "file": "",
        "folder": "",
        "snippet": "",
        "typeParameter": "",
        "default": " "
    },
    "suggest.labelMaxLength": 60,
    "diagnostic.virtualText": false,
    "diagnostic.enableMessage": "always",
    "diagnostic.checkCurrentLine": true,
    "diagnostic.refreshOnInsertMode": true,
    "diagnostic.displayByVimDiagnostic": true,
    "codeLens.enable": true,

    "suggest.floatConfig": {
        "border": true,
        "rounded": true
    },
    "diagnostic.floatConfig": {
        "border": true,
        "rounded": true
    },
    "signature.floatConfig": {
        "border": true,
        "rounded": true
    },
    "hover.floatConfig": {
        "border": true,
        "rounded": true
    },
    "git.floatConfig": {
        "border": true,
        "rounded": true
    },
    "cmake.formatter_args": ["--tab-size=4"],
    "colors.enable": true,
    "rust-analyzer.inlayHints.maxLength": 20,
    "rust-analyzer.lru.capacity": 512,
    "list.floatPreview": true,

    "semanticTokens.enable": true,
    "clangd.compilationDatabaseCandidates": [
        "${workspaceFolder}/Release",
        "${workspaceFolder}/Debug",
        "${workspaceFolder}/build",
        "${workspaceFolder}"
    ],
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-25",
            "path": "/usr/lib/jvm/default",
            "default": true
        }
    ],
    "editor.codeActionsOnSave": {
        "organizeImports": true
    },

    "prettier.tabWidth": 4,
    "prettier.disableLanguages": ["markdown"],

    "ruff.lint.args": ["--config", "target-version = \"py314\""],
    "ruff.lineLength": 100,

    "coc-qml.qmllsPath": "/usr/lib/qt6/bin/qmlls",

    "coc.preferences.formatOnSave": true,
    "coc.preferences.formatOnType": true,

    "clangd.arguments": [
        "--clang-tidy",
        "--completion-style=detailed",
        "--cross-file-rename",
        "--enable-config"
    ],

    "snippets.ultisnips.directories": [
        "UltiSnips",
        "$HOME/.local/share/nvim/site/pack/pckr/opt/vim-snippets/UltiSnips"
    ],

    "sumneko-lua.enableNvimLuaDev": true,
    "snippets.ultisnips.pythonPrompt": false,

    "languageserver": {
        "wgsl": {
            "command": "wgsl-analyzer",
            "filetypes": ["wgsl"],
            "initializationOptions": {
                "inlayHintsConfig": {
                    "enable": true
                }
            }
        },
        "ty": {
            "command": "ty",
            "args": ["server"],
            "filetypes": ["python"],
            "rootPatterns": ["pyproject.toml", ".git"]
        },
        "shaderslang": {
            "command": "slangd",
            "filetypes": ["shaderslang"]
        },
        "mojo": {
            "command": "mojo-lsp-server",
            "filetypes": ["mojo"]
        },
        "dup-detector": {
            "command": "/home/crl/.cargo/bin/dup-detector",
            "args": ["lsp"],
            "filetypes": [
                "rust",
                "python",
                "javascript",
                "typescript",
                "typescriptreact",
                "cpp",
                "c",
                "java",
                "go"
            ],
            "rootPatterns": ["dup-detector.toml", ".git"]
        }
    },
    "go.goplsPath": "/usr/bin/gopls",
    "json.schemaDownload.trustedDomains": {
      "https://opencode.ai": true,
      "https://models.dev": true,
      "https://github.com": true
    },
    "tombi.path": "/usr/bin/tombi"
}
